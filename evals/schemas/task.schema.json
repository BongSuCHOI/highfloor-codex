{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highfloor.local/evals/task.schema.json",
  "title": "Highfloor evaluation task-set metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_set_id",
    "integrity_hash",
    "payload_visibility",
    "slices"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "task_set_id": {
      "type": "string",
      "minLength": 1
    },
    "integrity_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_visibility": {
      "enum": [
        "private_during_run",
        "public"
      ]
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
